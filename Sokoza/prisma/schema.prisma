generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole { CUSTOMER ADMIN BUSINESS_OWNER BUSINESS_STAFF RIDER }
enum RequestStatus { PENDING APPROVED REJECTED ARCHIVED }
enum PollStatus { DRAFT PUBLISHED CLOSED }

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  role UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requests DemandRequest[]
  votes Vote[]
}
model Area {
  id String @id @default(cuid())
  name String @unique
  requests DemandRequest[]
  createdAt DateTime @default(now())
}
model Category {
  id String @id @default(cuid())
  name String @unique
  requests DemandRequest[]
  createdAt DateTime @default(now())
}
model DemandRequest {
  id String @id @default(cuid())
  title String
  description String?
  status RequestStatus @default(PENDING)
  userId String
  categoryId String?
  areaId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  category Category? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  area Area? @relation(fields:[areaId], references:[id], onDelete:SetNull)
  poll Poll?
  @@index([status])
  @@index([categoryId])
  @@index([areaId])
}
model Poll {
  id String @id @default(cuid())
  question String
  status PollStatus @default(DRAFT)
  requestId String @unique
  createdAt DateTime @default(now())
  publishedAt DateTime?
  request DemandRequest @relation(fields:[requestId], references:[id], onDelete:Cascade)
  votes Vote[]
}
model Vote {
  id String @id @default(cuid())
  userId String
  pollId String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  poll Poll @relation(fields:[pollId], references:[id], onDelete:Cascade)
  @@unique([userId,pollId])
  @@index([pollId])
}
